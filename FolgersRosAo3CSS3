#outer,
.wrapper {
  background-image: linear-gradient(to bottom, #e07b00, crimson, darkred);
}

#header .heading {
  height: 200px;
  width: 95%;
  margin-top: 12px;
  margin-bottom: 8px;
  background-color: none;
  background-image: url("https://i.imgur.com/nzyOWen.png");
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
}

#dashboard,
#main,
#footer .module {
  background: #CCB793;
  margin: .05em 0.5em;
  padding: 0.5em;
}

#main,
#inner .group,
#inner .region,
#footer .module,
fieldset,
.flash {
  border: 2px solid #3d0400;
  outline: 0;
  border-radius: 1.5em;
  box-shadow: 0 -4px 0 #6B352B, 0 4px 0 #6B552B, -4.5px 0 0 #B04430, 5px 0 0 #B04430, inset 0 0 4.5px;
  margin-bottom: 1em;
}

#inner .group {
  background-color: #CCB793;
}

fieldset {
  background-color: #AB8F74;
}

a:visited {
  color: black;
}

a:link {
  color: darkbrown;
}

a:hover {
  color: crimson;
}

a:active {
  color: darkred;
}

.blurb .module,
#inner .group .group .group,
fieldset {
  border: 0;
}

.group .header,
.blurb ul.tags,
#outer .current {
  background: #AB8F74;
  border: 3px solid #3d0400;
  border-radius: 2em;
  padding: 0.75em;
}

ul.tags li.warnings:before {
  content: "Warnings: ";
  color: #900;
  font-weight: bold;
}

li.warnings + li.relationships:before {
  content: "Relationships: ";
  color: #900;
  font-weight: bold;
}

li.relationships + li.characters:before {
  content: "Characters: ";
  color: #900;
  font-weight: bold;
}

li.characters + li.freeforms:before {
  content: "Additional Tags: ";
  color: #900;
  font-weight: bold;
}

li.warnings + li.characters:before {
  content: "Characters: ";
  color: #900;
  font-weight: bold;
}

li.warnings + li.freeforms:before {
  content: "Additional Tags: ";
  color: #900;
  font-weight: bold;
}

li.relationships + li.freeforms:before {
  content: "Additional Tags: ";
  color: #900;
  font-weight: bold;
}

li.relationships a {
  background: none;
}

.work .relationship a.tag {
  background: none;
}

.group .header {
  width: 96%;
}

#footer {
  background: none;
  border: none;
}

#header h1 {
  top: 0.5em;
  left: 0.5em;
}

#header #greeting {
  right: 2em;
}

#header h1 img {
  opacity: 0.75;
}

#header li.search {
  float: none;
  display: block;
  margin-top: 0.643em;
}

#header li.search input {
  border: none;
}

#header ul.primary a,
#header ul.primary .menu a,
#header .dropdown .menu a:hover,
#header .dropdown .menu a:focus {
  background: #AB8F74;
}

#dashboard {
  width: 12%;
  background-color: #CCB793;
}

#main.dashboard {
  position: relative;
  float: center;
  width: 80%;
}

#dashboard,
#dashboard.own {
  background-color: #CCB793;
}

#outer #footer .heading,
#outer #footer .actions a,
#header ul.primary a {
  color: #900;
}

.blurb ul.required-tags li span,
.bookmark .status span,
.actions a,
.action,
.actions input,
input[type="submit"],
button,
.current,
.actions label,
legend,
textarea,
input,
#header ul.primary a,
.icon {
  border: 0.75px solid #8B0000;
  border-radius: 2em;
  box-shadow: 0 0 1px #555;
}

#footer {
  height: 500px;
  margin-top: 25px;
  background-image: url("https://i.imgur.com/lHJcLLN.png");
  border: none;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
}

#main .index,
#header ul.primary,
#header ul.primary .menu {
  box-shadow: none;
  border: none;
  background: transparent;
}

#header .primary .menu li {
  border-bottom: none;
}
